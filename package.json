{
  "name": "pdfmini",
  "productName": "PDFmini",
  "version": "1.3.7",
  "description": "PDFmini - 轻量极简的 PDF 阅读与编辑工具",
  "repository": {
    "type": "git",
    "url": "https://github.com/1464530024/PDFmini.git"
  },
  "homepage": "https://github.com/1464530024/PDFmini#readme",
  "bugs": {
    "url": "https://github.com/1464530024/PDFmini/issues"
  },
  "author": "PDFmini",
  "license": "MIT",
  "main": "src/main/main.js",
  "scripts": {
    "build:renderer": "node scripts/build.js",
    "start": "npm run build:renderer && electron .",
    "dev": "npm run build:renderer && electron . --dev",
    "dist": "npm run build:renderer && electron-builder --win nsis --x64",
    "pack": "npm run build:renderer && electron-builder --win --dir",
    "smoke": "node scripts/run-smoke.js"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "3.11.174"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "esbuild": "^0.21.5"
  },
  "build": {
    "appId": "com.pdfmini.app",
    "productName": "PDFmini",
    "copyright": "Copyright © 2026 PDFmini",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/main/**/*",
      "src/renderer/index.html",
      "src/renderer/css/**/*",
      "src/renderer/dist/**/*",
      "package.json",
      "!node_modules/**/*",
      "!**/*.map"
    ],
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "buildDependenciesFromSource": false,
    "electronDist": "node_modules/electron/dist",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "artifactName": "PDFmini-Setup-${version}-x64.${ext}"
    },
    "afterPack": "scripts/after-pack.js",
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PDFmini",
      "uninstallDisplayName": "PDFmini",
      "deleteAppDataOnUninstall": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "language": "2052",
      "installerLanguages": [
        "zh_CN",
        "en_US"
      ],
      "multiLanguageInstaller": true,
      "displayLanguageSelector": true,
      "include": "installer/lang.nsh"
    },
    "compression": "maximum",
    "asar": true,
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ]
  }
}
